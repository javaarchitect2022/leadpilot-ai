# ==============================================================================
# LeadPilot AI — Production Git Ignore Rules
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js Build Output & Bundles
/.next/
/out/
/dist/
/build/

# TypeScript Incremental Build Cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# Environment Variables & Sensitive Secrets (NEVER push to GitHub)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env.production
!.env.example

# Local SQLite Database Files (Keep schema & seeds in repo, ignore runtime DB)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
prisma/dev.db*

# Dynamically Generated Government Documents & PDF Uploads
/public/documents/properties/*
!/public/documents/properties/.gitkeep

# Logs & Debugging Files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Unit Test & Coverage Reports
/coverage/
/.vitest/
*.lcov

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configuration
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Cloudflare & Vercel Deployment Artifacts
.vercel
.wrangler
