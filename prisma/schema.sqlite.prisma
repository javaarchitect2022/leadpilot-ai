generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  businessType String   @default("REAL_ESTATE")
  city         String
  country      String   @default("India")
  phone        String?
  email        String?
  currency     String   @default("INR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users         User[]
  leads         Lead[]
  properties    Property[]
  followUps     FollowUp[]
  activities    Activity[]
  notifications Notification[]
  subscription  Subscription?
  settings      OrganizationSettings?
  auditLogs     AuditLog[]
  aiAudits      AiAudit[]
  aiAnalyses    AiAnalysis[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  name           String
  phone          String?
  role           String   @default("SALES_USER")
  isActive       Boolean  @default(true)
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedLeads     Lead[]         @relation("AssignedLeads")
  assignedFollowUps FollowUp[]     @relation("AssignedFollowUps")
  activities        Activity[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, role])
}

model OrganizationSettings {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  preferredAiProvider String   @default("GEMINI")
  aiResponseTone      String   @default("Professional and consultative Indian real estate advisor")
  businessDescription String?  @default("Premium real estate advisory firm serving homebuyers and investors")
  defaultLanguage     String   @default("English (Indian)")
  followUpRules       String?  @default("{\"firstContactWithinHours\": 2, \"autoFollowUpDays\": 2}")
  webhookSecret       String?
  apiKeyHash          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Lead {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  phone           String
  email           String?
  source          String    @default("WEBSITE")
  status          String    @default("NEW")
  priority        String    @default("MEDIUM")
  leadScore       Int       @default(0)
  requirement     String?
  location        String?
  budgetMin       Float?
  budgetMax       Float?
  propertyType    String?
  bedrooms        Int?
  purchaseIntent  String    @default("UNKNOWN")
  urgency         String    @default("MEDIUM")
  assignedUserId  String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("AssignedLeads", fields: [assignedUserId], references: [id], onDelete: SetNull)
  aiAnalysis   AiAnalysis?
  followUps    FollowUp[]
  activities   Activity[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, createdAt])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, phone])
}

model AiAnalysis {
  id                    String   @id @default(cuid())
  organizationId        String
  leadId                String   @unique
  summary               String
  intent                String
  location              String?
  propertyType          String?
  bedrooms              Int?
  budgetMin             Float?
  budgetMax             Float?
  urgency               String
  leadScore             Int
  missingInformation    String   @default("[]")
  recommendedNextAction String
  rawOutput             String?
  modelUsed             String?
  createdAt             DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model FollowUp {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String
  assignedUserId String?
  scheduledAt    DateTime
  type           String    @default("CALL")
  status         String    @default("PENDING")
  message        String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("AssignedFollowUps", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, status])
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  userId         String?
  type           String
  description    String
  metadata       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, leadId])
  @@index([organizationId, createdAt])
}

model Property {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String?
  location       String
  city           String
  price          Float
  propertyType   String
  bedrooms       Int?
  bathrooms      Int?
  area           Float?
  status         String   @default("AVAILABLE")
  legalStatus    String   @default("PENDING_VERIFICATION")
  legalVerification String? @default("{}")
  images         String?  @default("[]")
  amenities      String?  @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    PropertyDocument[]

  @@index([organizationId])
  @@index([organizationId, city, status])
  @@index([organizationId, legalStatus])
  @@index([organizationId, price])
}

model PropertyDocument {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String
  documentType   String   // ENCUMBRANCE_CERTIFICATE, PATTA_CHITTA, FMB_SKETCH
  title          String
  fileName       String
  fileUrl        String
  fileSize       Int?
  mimeType       String   @default("application/pdf")
  status         String   @default("VERIFIED")
  extractedData  String?  @default("{}")
  verifiedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([organizationId])
  @@index([propertyId, documentType])
}

model TnJurisdiction {
  id        String   @id @default(cuid())
  zone      String
  district  String
  sro       String
  villages  String   // JSON string array of registration villages
  createdAt DateTime @default(now())

  @@unique([zone, district, sro])
  @@index([zone])
  @@index([district])
  @@index([sro])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  message        String
  type           String
  isRead         Boolean  @default(false)
  linkUrl        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([organizationId, isRead])
}

model Subscription {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  plan                   String   @default("STARTER")
  status                 String   @default("TRIAL")
  billingCycle           String   @default("MONTHLY")
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  currentPeriodStart     DateTime @default(now())
  currentPeriodEnd       DateTime
  leadLimit              Int      @default(500)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PlanConfig {
  id           String   @id @default(cuid())
  plan         String   @unique
  name         String
  priceMonthly Int
  priceAnnual  Int
  leadLimit    Int
  features     String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  details        String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, createdAt])
}

model AiAudit {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  leadId         String?
  prompt         String
  model          String
  response       String
  tokenCount     Int?
  durationMs     Int?
  cost           Float?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

