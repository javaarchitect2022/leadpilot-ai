{
  "name": "leadpilot-ai",
  "version": "0.1.0",
  "description": "LeadPilot AI — Production-Ready Multi-Tenant SaaS Platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"const fs=require('fs'); if(fs.existsSync('.open-next')) fs.rmSync('.open-next',{recursive:true,force:true});\" && next build && opennextjs-cloudflare build --skipNextBuild --dangerouslyUseUnsupportedNextVersion",
    "build:worker": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "deploy:dev": "node scripts/deploy-dev.mjs",
    "setup:hook": "node scripts/setup-git-hook.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.453.0",
    "next": "^14.2.35",
    "papaparse": "^5.4.1",
    "puppeteer": "^25.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "wrangler": "^4.134.0"
  },
  "overrides": {
    "next": "$next"
  }
}
